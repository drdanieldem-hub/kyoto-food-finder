# Memory archive lives on the `memory-archive` branch, not main.
# The cron job writes one file per run to memory-archive/; we don't
# want those cluttering main.
memory-archive/

# Daily snapshots live on the `backups/daily` branch — see scripts/daily_backup.py.
backups/

# experiments/ holds per-project clones (each has its own .git). We never want
# them tracked inside this repo.
experiments/

